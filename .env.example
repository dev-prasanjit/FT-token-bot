# ─── Flattrade Credentials ──────────────────────────────────────
FLATTRADE_USER_ID=YOUR_FLATTRADE_CLIENT_ID
FLATTRADE_PASSWORD=YOUR_FLATTRADE_PASSWORD
FLATTRADE_TOTP_SECRET=YOUR_TOTP_SECRET_KEY

# ─── Tradetron Auth URL ─────────────────────────────────────────
# This is the URL from Tradetron's "Broker & Exchanges" page
TRADETRON_AUTH_URL=https://flattrade.tradetron.tech/auth/823321

# ─── Telegram Bot ───────────────────────────────────────────────
# Create a bot via @BotFather on Telegram to get the token
# Send /start to the bot, then use @userinfobot to get your Chat ID
TELEGRAM_BOT_TOKEN=YOUR_TELEGRAM_BOT_TOKEN
TELEGRAM_CHAT_ID=YOUR_TELEGRAM_CHAT_ID

# ─── Optional ───────────────────────────────────────────────────
# Set to "false" to see the browser window (useful for debugging)
HEADLESS=true
